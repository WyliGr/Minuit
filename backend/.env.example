# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database
DB_PATH=database/minuit.sqlite

# Cache (in minutes; 360 = 6 hours)
CACHE_TTL_MINUTES=360

# Timezone the theaters live in (drives "today" showtime filtering)
SCHEDULES_TZ=Europe/Paris

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000